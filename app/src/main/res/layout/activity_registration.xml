<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:backgroundTint="#D1E6D2"
tools:context=".Registration">

<ImageView
    android:id="@+id/imageView2"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:scaleType="fitXY"
    app:srcCompat="@drawable/loginbackimg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/shop_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="25dp"
            android:background="@drawable/roundededittext_light"
            android:drawableLeft="@drawable/user12"
            android:ems="10"
            android:hint=" Username"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:paddingLeft="15dp"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/shop_mail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="25dp"
            android:background="@drawable/roundededittext_light"
            android:drawableLeft="@drawable/mailiconn"
            android:ems="10"
            android:hint=" E-mail"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:paddingLeft="15dp"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/user_mobile_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/roundededittext_light"
                android:drawableLeft="@drawable/phoneicon"
                android:ems="10"
                android:hint="Mobile number"
                android:inputType="phone"
                android:minHeight="48dp"
                android:paddingLeft="13dp"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/check"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="-30dp"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#B8520F"
                android:src="@drawable/ic_baseline_check_24"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/incorrectotp"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginLeft="-30dp"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#B8520F"
                android:src="@drawable/ic_baseline_error_24"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_loader"
                style="?android:attr/progressBarStyle"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="-30dp"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#B8520F"
                android:visibility="gone" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/shop_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="25dp"
                android:background="@drawable/roundededittext_light"
                android:drawableLeft="@drawable/passiconn"
                android:ems="10"
                android:hint=" Password"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:paddingLeft="15dp"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/button2"
                android:layout_width="25dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginStart="-57dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/eyeicon"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>

        <Button
            android:id="@+id/loginbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22sp"
            android:backgroundTint="#B049091B"
            android:text="REGISTER" />
    </LinearLayout>

